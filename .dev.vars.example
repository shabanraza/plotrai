OPENROUTER_API_KEY=sk-or-...
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://...supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
